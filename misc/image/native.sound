include ../misc/image/image.bas

mkdir %tmp%/binImg

catalog-read exp xz %mirr% experimental main
catalog-read sid xz %mirr% sid main
catalog-sum

select-one libc6-dev                      #library
select-one gcc                            #compiler
select-one gcc-multilib                   #compiler
select-one libasound-dev                  #sound
select-one libsndfile-dev                 #sound
select-one libsamplerate-dev              #sound

select-lst
select-sum
package-down
package-inst

catalog-save snd

copy ../misc %tmp%/

include ../misc/image/native.%comp%

exec cd %tmp%/misc/sound/ ; ./c.sh %find% ; ./p.sh

move %tmp%/binImg/*.tgz ../binImg/snd-%unam%.tgz

del %tmp%
