include ../misc/image/image.bas

mkdir %tmp%/binImg

catalog-read exp xz %mirr% experimental main
catalog-read sid xz %mirr% sid main
catalog-sum

select-dis librte-.*-.*
select-one libc6-dev                      #library
select-one gcc                            #compiler
select-one gcc-multilib                   #compiler
select-one dpdk-dev                       #dataplane
select-one libpcap-dev                    #dataplane
select-one libssl-dev                     #dataplane
select-one libbpf-dev                     #dataplane
select-one libxdp-dev                     #dataplane
select-one liburing-dev                   #dataplane
select-one libmnl-dev                     #dataplane
select-one libasound-dev                  #sound
select-one libsndfile-dev                 #sound
select-one libsamplerate-dev              #sound

select-lst
select-sum
package-down
package-inst

catalog-save crs

copy ../misc %tmp%/

include ../misc/image/native.%comp%

exec cd %tmp%/misc/sound/ ; ../native/d.sh ; ./c.sh %find% ; ./p.sh
move %tmp%/binImg/*.tgz ../binImg/snd-%unam%.tgz

exec cd %tmp%/misc/utils/ ; ../native/d.sh ; ./c.sh %find% ; ./p.sh
move %tmp%/binImg/*.tgz ../binImg/utl-%unam%.tgz

exec cd %tmp%/misc/serial/ ; ../native/d.sh ; ./c.sh %find% ; ./p.sh
move %tmp%/binImg/*.tgz ../binImg/ser-%unam%.tgz

exec cd %tmp%/misc/iface/ ; ../native/d.sh ; ./c.sh %find% ; ./p.sh
move %tmp%/binImg/*.tgz ../binImg/ifc-%unam%.tgz

exec cd %tmp%/misc/forward/ ; ../native/d.sh ; ./c.sh %find% ; ./p.sh
move %tmp%/binImg/*.tgz ../binImg/fwd-%unam%.tgz

exec /usr/bin/qemu-%qemu% -L %tmp%/ %tmp%/binTmp/p4bench.bin

del %tmp%
